{
  "name": "songsong-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "migration:extract": "tsx migration/extract.ts",
    "migration:import": "tsx migration/import.ts",
    "test:rules": "CI=true XDG_CONFIG_HOME=/tmp/songsong-firebase-config FIRESTORE_RULES_TEST_PORT=8085 firebase emulators:exec --config firebase.rules-test.json --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:unit": "vitest run tests/maps.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.2.1",
    "lucide-react": "^0.542.0",
    "parse5": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.15.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.2"
  }
}
